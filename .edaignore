/.git/
/.husky/
/.vscode/
/build/
/config/
/coverage/
/node_modules/
/src/
/.editorconfig
/.gitattributes
/.gitignore
/.npmrc
/eslint.config.mjs
/package-lock.json
/package.json
/tsconfig.json
.eslintcache
debug.log
/docs/
/.dsh/
/scripts/
/.sdk-manifest.json
/.npm-cache/
# 临时探查/编译中间产物目录（本地调试用，不应进入分发包）。
/.*-probe/
/tmp/
# 测试图纸目录（libredwg 官方样例 + 截图），只用于本地解析诊断，不进扩展包。
/case/
# wasm 解析引擎读 DWG 时会在旁边留下锁/备份文件；一旦被打包流程读到
# （文件被占用时会以读取错误中断流式打包，产出没有中央目录的损坏 zip），
# 整个 .eext 就废了——全局排除兜底。
*.lck
*.bak
# dev 调试（npm run debug）会把 .eext 产到 dist/；tsc 增量信息也会落进 dist/。
# 不排除的话，下次打包会把旧包整个套娃进新包（实测体积翻倍）。
*.eext
*.tsbuildinfo
# 运行时只读取 dist/ 下由构建复制的那一份；
# 仓库根 vendor/ 是同步来源，不需要打进扩展包（否则 wasm 会重复一份，包体翻倍）。
/vendor/